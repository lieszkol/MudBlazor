@namespace MudBlazor
@inherits MudComponentBase

<div @attributes="UserAttributes" class="@Classname" style="@Style">
    <div class="mud-input-control-input-container">
        @InputContent
        @if (ShowFieldDescription)
        {
            @* Fork addition (see FieldDescription). The text is already in the parameter when the field is created, so a
               hover fetches nothing; the MudTooltip's own hover event is the only server round trip, once per hovered bulb
               (its popover is mounted lazily on the first hover, see MudTooltip). The svg is the Material "lightbulb" outline. *@
            <MudTooltip Placement="Placement.Top" Delay="200" Class="zen-field-description-tip" RootClass="zen-field-description">
                <ChildContent>
                    <svg class="mud-icon-root mud-svg-icon" focusable="false" viewBox="0 0 24 24" role="img" aria-label="@FieldDescription">@((MarkupString)Icons.Material.Outlined.Lightbulb)</svg>
                </ChildContent>
                <TooltipContent>@FieldDescription</TooltipContent>
            </MudTooltip>
        }
        @if (IsFieldModified)
        {
            @* Fork addition (see FieldModification). A plain button with a NATIVE title: the original value shows on hover
               without a server round trip. tabindex -1 keeps it out of the dialog's Tab order (a mouse convenience; the
               keyboard user simply retypes). stopPropagation needs the real @onclick handler on the same element. The svg
               is the Material "undo" outline. *@
            <button type="button" class="zen-field-undo" tabindex="-1" title="@FieldModification!.UndoTooltip" aria-label="@FieldModification!.UndoTooltip"
                    @onclick="OnUndoClickAsync" @onclick:stopPropagation="true">
                <svg class="mud-icon-root mud-svg-icon" focusable="false" viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)Icons.Material.Outlined.Undo)</svg>
            </button>
        }
        @if (!string.IsNullOrEmpty(Label))
        {
            <MudInputLabel Class="mud-input-label-inputcontrol" Variant="@Variant" Disabled=@Disabled Error="@Error" 
                           Margin="@Margin" ForId="@ForId">
                @Label
            </MudInputLabel>
        }
    </div>
    @if (Error || !string.IsNullOrEmpty(HelperText) || !string.IsNullOrEmpty(CounterText))
    {
        <div class="@HelperContainer">
            <p class="@HelperClass">
                <div class="d-flex">
                    @if (Error)
                    {
                        <div class="me-auto" id="@ErrorId">
                            @ErrorText
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(HelperText))
                    {
                        <div class="me-auto">
                            @HelperText
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(CounterText))
                    {
                        <div class="ms-auto">
                            @CounterText
                        </div>            
                    }
                </div>
            </p>
        </div>
    }
    @ChildContent
</div>